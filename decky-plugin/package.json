{
  "name": "steamos-konsole",
  "version": "0.1.0",
  "description": "Zeigt die SteamOS-Konsolen-Einstellungen (LEDs, Sound, Tags) direkt im Quick-Access-Menu von Big Picture.",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky",
    "plugin"
  ],
  "author": "Nico Bollhalder (BolliSoft)",
  "license": "MIT",
  "dependencies": {
    "@decky/ui": "^4.5.7",
    "react-icons": "^5.0.1"
  },
  "devDependencies": {
    "@decky/api": "^1.1.2",
    "@decky/rollup": "^1.0.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.9.6",
    "shx": "^0.3.4",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
